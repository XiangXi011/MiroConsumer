[run]
omit =
    # External integrations requiring live API keys
    backend/app/services/zep_*.py
    # LLM-dependent modules that cannot be deterministically tested in CI
    backend/app/services/ontology_generator.py
    # Legacy OASIS profile generator (deprecated, superseded by consumer module)
    backend/app/services/oasis_profile_generator.py

[report]
omit =
    # External integrations requiring live API keys
    backend/app/services/zep_*.py
    # LLM-dependent modules that cannot be deterministically tested in CI
    backend/app/services/ontology_generator.py
    # Legacy OASIS profile generator (deprecated, superseded by consumer module)
    backend/app/services/oasis_profile_generator.py
fail_under = 80
show_missing = true
