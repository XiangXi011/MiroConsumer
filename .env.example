# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 数据库配置（可选） =====
# 留空使用文件系统存储；sqlite:///path/to/db.sqlite 使用 SQLite
# postgresql+psycopg://user:pass@host/db 使用 PostgreSQL
DB_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_SECONDS=30

# ===== 队列配置 =====
QUEUE_BACKEND=thread
REDIS_URL=
LOCK_BACKEND=auto
QUEUE_RETRY_LIMIT=3
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300

# ===== Gunicorn 配置（生产容器）=====
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# ===== 存储配置 =====
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ===== Phase 7D 成本与运行上限 =====
MAX_AGENTS=1000
MAX_ROUNDS=10
LLM_BUDGET_LIMIT=500
LLM_DEEP_REASONING_RATIO=0.1
ENABLE_DETERMINISTIC_FALLBACK=true

# ===== Feature flags =====
ENABLE_SOCIETY_MODE=true
ENABLE_GRAPH_MEMORY_WRITEBACK=false

# ===== Flask 配置 =====
FLASK_DEBUG=false
SECRET_KEY=dev-only-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== 镜像配置 =====
MIROCONSUMER_IMAGE=ghcr.io/xiangxi011/miroconsumer:latest
