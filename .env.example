# LLM API configuration. Compatible with OpenAI-style chat endpoints.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# Zep Cloud configuration.
ZEP_API_KEY=your_zep_api_key_here

# Optional high-throughput LLM profile.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# Database configuration. Leave DB_URL empty for local filesystem defaults,
# or set sqlite:///path/to/db.sqlite / postgresql+psycopg://user:pass@host/db.
DB_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_SECONDS=30

# Queue and distributed coordination.
QUEUE_BACKEND=thread
REDIS_URL=
REDIS_PERSISTENCE_ENABLED=true
LOCK_BACKEND=auto
QUEUE_RETRY_LIMIT=3
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300

# Rate limiting. Production should keep this enabled and use Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_MINUTE=10

# Sentry error tracking (optional).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05

# Gunicorn container settings.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# Storage backend.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Runtime controls.
MAX_AGENTS=1000
MAX_ROUNDS=10
LLM_BUDGET_LIMIT=500
LLM_DEEP_REASONING_RATIO=0.1
ENABLE_DETERMINISTIC_FALLBACK=true

# Feature flags.
ENABLE_SOCIETY_MODE=true
ENABLE_GRAPH_MEMORY_WRITEBACK=false

# Flask and browser access.
FLASK_DEBUG=false
# SECURITY WARNING: Generate a strong SECRET_KEY for production!
# Use: openssl rand -base64 32
# Default below is intentionally insecure and will fail startup in production mode.
SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Image tag used by non-prod compose workflows.
MIROCONSUMER_IMAGE=ghcr.io/xiangxi011/miroconsumer:latest